; Restore Legacy Notepad (Windows 11)

; --- Fix Registry Deletions ---

; Remove specific 'App Paths' entry for Notepad in Current User
[-HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\App Paths\notepad.exe]

; Remove 'NoOpenWith' value to allow Notepad to appear in Open With lists
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Applications\notepad.exe]
"NoOpenWith"=-


; --- File Associations and Context Menu Entries ---

; Add Notepad to generic OpenWithList
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\OpenWithList\notepad.exe]

; Add Notepad to .htm OpenWithList
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.htm\OpenWithList\notepad.exe]

; Define File Types
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.inf]
@="inffile"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.ini]
@="inifile"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.log]
@="txtfile"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.ps1]
@="Microsoft.PowerShellScript.1"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.psd1]
@="Microsoft.PowerShellData.1"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.psm1]
@="Microsoft.PowerShellModule.1"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.scp]
@="txtfile"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.txt]
@="txtfile"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.txt\ShellNew]
"ItemName"="@%SystemRoot%\\system32\\notepad.exe,-470"
"NullFile"=" "

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\.wtx]
@="txtfile"


